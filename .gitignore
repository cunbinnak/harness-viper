# --- Build artifacts (dọn — PROTOCOL §2 luật #9; không commit) ---
__pycache__/
*.py[cod]
.venv/
target/
build/
.gradle/
dist/
out/
.next/
node_modules/
*.class

# --- Secret / env ---
.env
.env.*
!.env.example
deployment/**/.env

# --- Test / phân tích tạm (screenshot/trace dọn — luật #9) ---
playwright-report/
.playwright-mcp/
test-results/
*-trace.zip

# --- IDE / OS ---
.idea/
.vscode/settings.json
.claude/settings.local.json
.DS_Store
Thumbs.db
*.swp

# --- Gói nén / bản tải về (không track) ---
*.zip

# services/ KHÔNG ignore — MAIN code trực tiếp + commit (MAIN code trực tiếp trong repo).
# Build artifact BÊN TRONG services/ vẫn bị bắt bởi pattern global ở trên.

# reanchor audit log (local)
.reanchor.log
